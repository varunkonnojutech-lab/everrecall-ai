## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# Rider
.idea/

# VS Code (keep launch/tasks for the F5 experience)

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Publish output
publish/

# SQLite database (created at runtime)
*.db
*.db-shm
*.db-wal
everrecall.db
everrecall.db-shm
everrecall.db-wal

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Local env (real secrets live here — .env.example is the template)
.env
.env.*
!.env.example
